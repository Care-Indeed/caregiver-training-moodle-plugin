{{!
    @template local_caregivertraining/email

    CI Institute of Nursing branded email. Table layout and inline styles only, because most
    email clients drop <style> blocks and modern CSS layout.

    Context variables required for this template:
    * subject - email subject, used as the document title
    * preheader - hidden inbox preview text
    * sitename - site name, also the logo alt text
    * logourl - absolute logo URL (optional; the site name is shown instead)
    * hrcopy - banner text for HR copies (optional)
    * label - status label above the heading
    * labelbg, labelfg - status label colours
    * heading - main heading
    * bodyhtml - escaped, paragraph-formatted body
    * hasdetails, details - label/value rows for the key facts
    * image - picture with url, alt and link (optional)
    * cta - button with url, label and fallback text (optional)
    * notehtml - escaped extra note below the button (optional)
    * footer - footer text

    Example context (json):
    {
        "subject": "Your annual caregiver training is now open",
        "preheader": "Complete it on or before November 12, 2026.",
        "sitename": "CI Institute of Nursing",
        "logourl": "",
        "hrcopy": "",
        "label": "Training open",
        "labelbg": "#FFF6DD",
        "labelfg": "#946D00",
        "heading": "Your annual training is open",
        "bodyhtml": "<p>Hello Aldrin,</p><p>Your annual caregiver training is now open.</p>",
        "hasdetails": true,
        "details": [{"label": "Complete by", "value": "November 12, 2026"}],
        "image": null,
        "cta": {"url": "https://example.com/course/view.php?id=2", "label": "Start training",
            "fallback": "Button not working? Copy this link into your browser:"},
        "notehtml": "",
        "footer": "CI Institute of Nursing · Annual caregiver training."
    }
}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{subject}}</title>
</head>
<body style="margin:0;padding:0;background-color:#F2F0F0;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#F2F0F0;">{{preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F2F0F0;">
<tr>
<td align="center" style="padding:32px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#FFFFFF;border-radius:12px;overflow:hidden;font-family:Poppins,'Segoe UI',Helvetica,Arial,sans-serif;">
    <tr>
        <td style="height:6px;line-height:6px;font-size:0;background-color:#E5393C;">&nbsp;</td>
    </tr>
    {{#hrcopy}}
    <tr>
        <td style="padding:10px 32px;background-color:#FFF6DD;color:#4B3700;font-size:13px;line-height:1.5;">{{hrcopy}}</td>
    </tr>
    {{/hrcopy}}
    <tr>
        <td style="padding:28px 32px 4px 32px;">
            {{#logourl}}<img src="{{logourl}}" alt="{{sitename}}" height="44" style="display:block;height:44px;width:auto;border:0;outline:none;">{{/logourl}}
            {{^logourl}}<span style="font-size:18px;font-weight:600;color:#B11517;">{{sitename}}</span>{{/logourl}}
        </td>
    </tr>
    <tr>
        <td style="padding:20px 32px 0 32px;">
            <span style="display:inline-block;padding:4px 12px;border-radius:999px;background-color:{{labelbg}};color:{{labelfg}};font-size:12px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;">{{label}}</span>
            <h1 style="margin:14px 0 0 0;font-size:24px;line-height:1.3;font-weight:600;color:#1B1818;">{{heading}}</h1>
        </td>
    </tr>
    <tr>
        <td style="padding:18px 32px 0 32px;font-size:15px;line-height:1.65;color:#544B4B;">{{{bodyhtml}}}</td>
    </tr>
    {{#hasdetails}}
    <tr>
        <td style="padding:6px 32px 0 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FFFBF0;border-left:4px solid #FFCE47;border-radius:8px;">
                {{#details}}
                <tr>
                    <td style="padding:10px 16px;font-size:13px;line-height:1.4;color:#857676;width:42%;">{{label}}</td>
                    <td style="padding:10px 16px;font-size:14px;line-height:1.4;font-weight:600;color:#1B1818;">{{value}}</td>
                </tr>
                {{/details}}
            </table>
        </td>
    </tr>
    {{/hasdetails}}
    {{#image}}
    <tr>
        <td style="padding:24px 32px 0 32px;">
            <a href="{{link}}" target="_blank" style="text-decoration:none;"><img src="{{url}}" alt="{{alt}}" width="536" style="display:block;width:100%;max-width:536px;height:auto;border:1px solid #E1DDDD;border-radius:8px;outline:none;"></a>
        </td>
    </tr>
    {{/image}}
    {{#cta}}
    <tr>
        <td style="padding:28px 32px 0 32px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td align="center" bgcolor="#B11517" style="border-radius:8px;background-color:#B11517;">
                        <a href="{{url}}" target="_blank" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:600;line-height:1;color:#FFFFFF;text-decoration:none;border-radius:8px;">{{label}}</a>
                    </td>
                </tr>
            </table>
            <p style="margin:14px 0 0 0;font-size:12px;line-height:1.5;color:#857676;">{{fallback}}<br><a href="{{url}}" target="_blank" style="color:#B11517;word-break:break-all;">{{url}}</a></p>
        </td>
    </tr>
    {{/cta}}
    {{#notehtml}}
    <tr>
        <td style="padding:20px 32px 0 32px;font-size:13px;line-height:1.6;color:#544B4B;">{{{notehtml}}}</td>
    </tr>
    {{/notehtml}}
    <tr>
        <td style="padding:32px 32px 28px 32px;">
            <div style="border-top:1px solid #E1DDDD;padding-top:16px;font-size:12px;line-height:1.6;color:#857676;">{{footer}}</div>
        </td>
    </tr>
</table>
</td>
</tr>
</table>
</body>
</html>
